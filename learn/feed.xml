---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Claryo guides</title>
  <subtitle>Short guides to the questions a household's money raises.</subtitle>
  <id>{{ '/learn/' | absolute_url }}</id>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" href="{{ '/learn/' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Claryo</name></author>
  <icon>{{ '/assets/favicon.png' | absolute_url }}</icon>
  {%- assign guides = site.pages | where: "layout", "guide" | sort: "date" | reverse %}
  {%- for g in guides %}
  <entry>
    <title>{{ g.title | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ g.url | absolute_url }}"/>
    <id>{{ g.url | absolute_url }}</id>
    <updated>{{ g.date | default: site.time | date_to_xmlschema }}</updated>
    <summary>{{ g.description | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
